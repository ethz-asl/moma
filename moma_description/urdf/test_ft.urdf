<?xml version='1.0' encoding='utf-8'?>
<robot name="panda">

 <link name="my_box">
    <inertial>
      <origin xyz="2 0 0" />
      <mass value="1.0" />
      <inertia  ixx="1.0" ixy="0.0"  ixz="0.0"  iyy="100.0"  iyz="0.0"  izz="1.0" />
    </inertial>
    <visual>
      <origin xyz="2 0 1"/>
      <geometry>
        <box size="1 1 2" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="2 0 1"/>
      <geometry>
        <box size="1 1 2" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="my_box">
    <material>Gazebo/Blue</material>
  </gazebo>

  <link name="my_box2">
    <inertial>
      <origin xyz="2 0 0" />
      <mass value="1.0" />
      <inertia  ixx="1.0" ixy="0.0"  ixz="0.0"  iyy="100.0"  iyz="0.0"  izz="1.0" />
    </inertial>
    <visual>
      <origin xyz="2 0 1"/>
      <geometry>
        <box size="1 1 2" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="2 0 1"/>
      <geometry>
        <box size="1 1 2" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_01" type="revolute">
    <!-- <provideFeedback>true</provideFeedback> -->
    <axis xyz="0 0 2"/>
    <limit effort="1000.0" lower="0.0" upper="0.548" velocity="0.5"/>
    <origin rpy="0 0 0" xyz="0.2 0.01 0"/>
    <parent link="my_box"/>
    <child link="my_box2"/>
    <!-- <sensor name="force_torque" type="force_torque">
      <update_rate>30</update_rate>
    </sensor> -->
    <!-- <sensor name="force_torque" type="force_torque">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin filename="libgazebo_ros_ft_sensor.so" name="ft_sensor">
        <topicName>/ft_sensor_topic</topicName>
        <jointName>joint_01</jointName>
      </plugin>
    </sensor>/ -->
  </joint>

  <!-- Enable the Joint Feedback -->
  <gazebo reference="joint_01">
    <provideFeedback>true</provideFeedback>
  </gazebo>

  <gazebo>
    <plugin filename="libgazebo_ros_ft_sensor.so" name="ft_sensor">
      <topicName>/ft_sensor_topic</topicName>
      <jointName>joint_01</jointName>
      <update_rate>50.0</update_rate>
    </plugin>
  </gazebo>
  
  <gazebo>
    <plugin name="differential_drive_controller" filename="libdiffdrive_plugin.so">
    </plugin>
  </gazebo>

</robot>
