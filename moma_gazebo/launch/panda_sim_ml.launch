<?xml version="1.0"?>
<launch>

  <!-- Robot arguments -->
  <arg name="arm_id" default="panda" />
  <arg name="use_gripper" default="true" />
  <arg name="moveit" default="true"/>
  <arg name="arm_controller" default="position_joint_trajectory_controller"/>
  <arg name="moveit_planner" default="ompl"/>
  <arg name="use_fixed_camera" default="false"/>
  <arg name="use_wrist_camera" default="true" />
  <arg name="interactive_marker" value="false"/>
  <arg name="rviz" default="true" />

  <!-- Table arguments (renamed + new Z spec) -->
  <arg name="table_size_x" default="1.0"/>
  <arg name="table_size_y" default="1.0"/>
  <!-- Heights are absolute in world coordinates -->
  <arg name="table_z_top" default="0."/>
  <arg name="table_z_bottom" default="-0.15"/>

  <!-- From the robot base to the edge of the table in the x direction (i.e. forward) -->
  <arg name="table_offset_x" default="0.1"/>
  <arg name="table_root_x" default="$(eval (float(arg('table_size_x'))/2.0 + float(arg('table_offset_x'))))"/>

  <!-- Sim arguments -->
  <arg name="gazebo" default="true" />
  <arg name="headless" default="false" />
  <arg name="paused" default="false" />
  <arg name="use_sim_time" default="true" />
  <arg name="world" default="$(find moma_gazebo)/worlds/moma_corner.world"/>

  <!-- Joint positions -->
  <arg name="initial_joint_positions"
    default="-J $(arg arm_id)_joint1 -0.15708
            -J $(arg arm_id)_joint2 -0.331613
            -J $(arg arm_id)_joint3 0
            -J $(arg arm_id)_joint4 -2.07694
            -J $(arg arm_id)_joint5 0
            -J $(arg arm_id)_joint6 1.74533
            -J $(arg arm_id)_joint7 0.663225
            -J $(arg arm_id)_finger_joint1 0.01
            -J $(arg arm_id)_finger_joint2 0.01" />

  <!-- Gazebo world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch" if="$(arg gazebo)">
    <arg name="paused" value="$(arg paused)" />
    <arg name="gui" value="$(eval not arg('headless'))" />
    <arg name="use_sim_time" value="$(arg use_sim_time)" />
  </include>

  <!-- Load Panda robot description -->
  <param name="robot_description"
    command="$(find xacro)/xacro $(find moma_description)/urdf/panda.urdf.xacro
        publish_realsense_extrinsics:=true
        gazebo:=$(arg gazebo)
        include_control_plugin:=true
        use_fixed_camera:=$(arg use_fixed_camera)
        use_wrist_camera:=$(arg use_wrist_camera)"/>

  <!-- Panda robot_state_publisher -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen"/>

  <!-- Table namespace with its own robot_description -->
  <group ns="table">
    <param name="robot_description" 
      command="$(find xacro)/xacro $(find moma_description)/urdf/table.urdf.xacro
        table_size_x:=$(arg table_size_x)
        table_size_y:=$(arg table_size_y)
        table_z_top:=$(arg table_z_top)
        table_z_bottom:=$(arg table_z_bottom)"/>
    <node name="state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="table_tf_pub"
          args="$(arg table_root_x) 0 0 0 0 0 world table_root" />
  </group>

  <!-- xyz, xyzw quaternion -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="grasp_area_tf_pub" args="0.30 0.15 0.0 0 0 -0.7071068, 0.7071068  panda_link0 table_top_link" />

  <!-- Controllers configuration -->
  <rosparam file="$(find moma_gazebo)/config/franka_hw_sim.yaml" subst_value="true" />
  <rosparam file="$(find moma_gazebo)/config/sim_controllers.yaml" subst_value="true" />

  <!-- Gripper mass parameter -->
  <param name="m_ee" value="0.76" if="$(arg use_gripper)" />

  <!-- Spawn gripper controller -->
  <node pkg="controller_manager"
        type="spawner"
        name="$(arg arm_id)_gripper_spawner"
        if="$(arg use_gripper)"
        args="franka_gripper"
        respawn="false" />

  <!-- Spawn arm controllers -->
  <node pkg="controller_manager"
        type="spawner"
        name="$(arg arm_id)_controller_spawner"
        respawn="false"
        output="screen"
        args="--wait-for initialized franka_state_controller $(arg arm_controller)" />

  <!-- Interactive marker (optional) -->
  <node name="interactive_marker"
        pkg="franka_example_controllers"
        type="interactive_marker.py"
        if="$(arg interactive_marker)">
    <param name="link_name" value="$(arg arm_id)_link0" />
    <remap to="cartesian_impedance_example_controller/equilibrium_pose" from="equilibrium_pose"
           if="$(eval arg('arm_controller') == 'cartesian_impedance_example_controller')" />
    <remap to="cartesian_impedance_trajectory_controller/reference_pose" from="equilibrium_pose"
           if="$(eval arg('arm_controller') == 'cartesian_impedance_trajectory_controller')" />
  </node>

  <!-- Start MoveIt! -->
  <include if="$(arg moveit)" file="$(find panda_moveit_config)/launch/move_group.launch">
    <arg name="load_robot_description" value="false"/>
    <arg name="pipeline" value="$(arg moveit_planner)"/>
  </include>

  <!-- Joint state publisher -->
  <node name="joint_state_publisher" type="joint_state_publisher" pkg="joint_state_publisher">
    <rosparam param="source_list">
      [franka_state_controller/joint_states, franka_gripper/joint_states]
    </rosparam>
    <param name="rate" value="30"/>
  </node>

  <!-- Spawn Panda robot in Gazebo -->
  <arg name="unpause" value="$(eval '' if arg('paused') else '-unpause')" />
  <node name="$(arg arm_id)_model_spawner"
        pkg="gazebo_ros"
        type="spawn_model"
        args="-param robot_description -urdf -model $(arg arm_id) $(arg unpause) $(arg initial_joint_positions)" />

  <!-- Table namespace with its own robot_description -->
  <!-- <group ns="table">
    <node name="table_spawner"
          pkg="gazebo_ros"
          type="spawn_model"
          output="screen"
          args="-param robot_description -urdf -model table -x $(arg table_root_x) -y 0 -z 0">
    </node>
  </group> -->

  <!-- RViz -->
  <node if="$(arg rviz)" name="$(anon rviz)" pkg="rviz" type="rviz"
        respawn="false"
        args="-d $(find moma_gazebo)/config/panda.rviz"
        output="screen"/>

</launch>
