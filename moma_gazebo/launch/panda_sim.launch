<?xml version="1.0"?>
<launch>

    <!-- Debug arguments -->
    <arg name="verbose" default="true"/>

    <!-- Robot arguments -->
    <arg name="arm_id" default="panda" />
    <arg name="use_gripper" default="true" />
    <arg name="moveit" default="true"/>
    <arg name="arm_controller" 
        if="$(arg moveit)" default="position_joint_trajectory_controller"/>
    <arg name="arm_controller" 
        unless="$(arg moveit)" default="cartesian_impedance_example_controller"/>
    <arg name="moveit_planner" default="ompl"/>
    <arg name="use_fixed_camera" default="false"/>
    <arg name="use_wrist_camera" default="true" />
    <arg name="seed" default="5" />

    <!-- Object arguments -->
    <arg name="side_length" default="0.04"/>
    <arg name="mass_m" default="0.05" />     
    <arg name="mass_l" default="0.05" />
    <!-- <arg name="mass_r" default="0.05" />   -->
    <arg name="mass_r" default="0.2" /> 
    <arg name="file_name" default="single_cube" /> 
    <arg name="spawn_x" default="0.5" /> 

    <!-- Data recording arguments -->
    <arg name="obj_name" default="I_symmetric_2"/>
    <arg name="out_path" default="/home/toni/Documents/robotx/dataset"/>

  <!-- If we don't do moveit, start the interactive markers. -->
  <arg name="interactive_marker"
    default="$(eval arg('arm_controller') == 'cartesian_impedance_example_controller')"/>

    <!-- Sim arguments -->
    <arg name="gazebo" default="true" />
    <arg name="headless" default="false" />
    <arg name="paused" default="false" />
    <arg name="use_sim_time" default="true" />
    <arg name="world" default="$(find moma_gazebo)/worlds/simple.world" />
    <arg name="rviz" default="true" />

    <!-- Joint positions -->
    <!-- <arg name="initial_joint_positions"
        default="-J $(arg arm_id)_joint1 0
                -J $(arg arm_id)_joint2 0
                -J $(arg arm_id)_joint3 0
                -J $(arg arm_id)_joint4 -1.5708
                -J $(arg arm_id)_joint5 0
                -J $(arg arm_id)_joint6 1.5708
                -J $(arg arm_id)_joint7 0.7854
                -J $(arg arm_id)_finger_joint1 0.035
                -J $(arg arm_id)_finger_joint2 0.035" /> -->

    <!-- Start at -0.15 pre grasp position essentially -->
    <arg name="initial_joint_positions"
        default="-J $(arg arm_id)_joint1 0
                -J $(arg arm_id)_joint2 0.1079
                -J $(arg arm_id)_joint3 0
                -J $(arg arm_id)_joint4 -2.3920
                -J $(arg arm_id)_joint5 0
                -J $(arg arm_id)_joint6 2.4988
                -J $(arg arm_id)_joint7 0.7857
                -J $(arg arm_id)_finger_joint1 0.035
                -J $(arg arm_id)_finger_joint2 0.035" />

    <!-- Start at grasp position essentially -->
    <!-- <arg name="initial_joint_positions"
        default="-J $(arg arm_id)_joint1 0
                -J $(arg arm_id)_joint2 0.5
                -J $(arg arm_id)_joint3 0
                -J $(arg arm_id)_joint4 -2.3573
                -J $(arg arm_id)_joint5 0
                -J $(arg arm_id)_joint6 2.8439
                -J $(arg arm_id)_joint7 0.8407
                -J $(arg arm_id)_finger_joint1 0.035
                -J $(arg arm_id)_finger_joint2 0.035" /> -->

    <!-- Start at pregrasp position essentially -->
    <!-- <arg name="initial_joint_positions"
        default="-J $(arg arm_id)_joint1 0
                -J $(arg arm_id)_joint2 0.2226
                -J $(arg arm_id)_joint3 0
                -J $(arg arm_id)_joint4 -2.4010
                -J $(arg arm_id)_joint5 0
                -J $(arg arm_id)_joint6 2.6219
                -J $(arg arm_id)_joint7 0.7849
                -J $(arg arm_id)_finger_joint1 0.035
                -J $(arg arm_id)_finger_joint2 0.035" /> -->

    <include file="$(find gazebo_ros)/launch/empty_world.launch" if="$(arg gazebo)">
        <arg name="world_name" value="$(arg world)" />
        <arg name="paused" value="$(arg paused)" />
        <arg name="gui" value="$(eval not arg('headless'))" />
        <arg name="use_sim_time" value="$(arg use_sim_time)" />
        <arg name="extra_gazebo_args" value="--seed $(arg seed)" />
        <arg name="verbose" default="$(arg verbose)"/>
    </include>

    <!-- Spawn cube directly via URDF -->
    <!-- <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" args="-file $(find moma_description)/urdf/I_object_symmetric.urdf -urdf -model object -x 0.5 -y 0 -z 0.05" /> -->

    <!-- Spawn cube via xacro -->
    <!-- send cube urdf to param server -->
    <param name="cube_description" command="$(find xacro)/xacro $(find moma_description)/urdf/object.urdf.xacro side_length:=$(arg side_length) 
        mass_m:=$(arg mass_m)
        mass_l:=$(arg mass_l)
        mass_r:=$(arg mass_r)
        file_name:=$(arg file_name)" />

    <!-- push cube_description to factory and spawn robot in gazebo -->
    <!-- specify init pose with x/y/z params -->
    <node name="cube_model_spawner" pkg="gazebo_ros" type="spawn_model" args="-param cube_description -urdf -model cube_model -x $(arg spawn_x) -y 0 -z 0.1 " respawn="false" output="screen" />

    <!-- Load robot description  -->
    <param name="robot_description"
        command="$(find xacro)/xacro $(find moma_description)/urdf/panda.urdf.xacro
            publish_realsense_extrinsics:=true
            gazebo:=$(arg gazebo)
            include_control_plugin:=true
            use_fixed_camera:=$(arg use_fixed_camera)
            use_wrist_camera:=$(arg use_wrist_camera)"/>

    <!-- Arm controller params -->
    <rosparam file="$(find franka_gazebo)/config/franka_hw_sim.yaml" subst_value="true" />
    <rosparam file="$(find franka_gazebo)/config/sim_controllers.yaml" subst_value="true" />

    <param name="m_ee" value="0.76" if="$(arg use_gripper)" />

    <!-- Spawn required ROS controllers -->
    <node pkg="controller_manager"
            type="spawner"
            name="$(arg arm_id)_gripper_spawner"
            if="$(arg use_gripper)"
            args="franka_gripper"
            respawn="false" />

    <!-- spawns the controller after the robot was put into its initial joint pose -->
    <node pkg="controller_manager"
            type="spawner"
            name="$(arg arm_id)_controller_spawner"
            respawn="false" output="screen"
            args="--wait-for initialized franka_state_controller $(arg arm_controller)" />
        
    <node name="interactive_marker"
        pkg="franka_example_controllers"
        type="interactive_marker.py"
        if="$(arg interactive_marker)">
        <param name="link_name" value="$(arg arm_id)_link0" />
        <remap to="cartesian_impedance_example_controller/equilibrium_pose" from="equilibrium_pose" />
    </node>

    <!-- Start up MoveIt! for arm -->
    <include if="$(arg moveit)" file="$(find panda_moveit_config)/launch/move_group.launch">
        <arg name="load_robot_description" value="false"/>
        <arg name="pipeline" value="$(arg moveit_planner)"/>
    </include>

    <node name="robot_state_publisher" pkg="robot_state_publisher" 
        type="robot_state_publisher" output="screen" />

    <node name="joint_state_publisher" type="joint_state_publisher" pkg="joint_state_publisher">
        <rosparam param="source_list">
            [franka_state_controller/joint_states,
            franka_gripper/joint_states]
        </rosparam>
        <param name="rate" value="30"/>
    </node>

    <!-- Spawn panda -->
    <arg name="unpause" value="$(eval '' if arg('paused') else '-unpause')" />
    <node name="$(arg arm_id)_model_spawner"
        pkg="gazebo_ros"
        type="spawn_model"
        args="-param robot_description -urdf -model $(arg arm_id) $(arg unpause)
              $(arg initial_joint_positions)" />

    <!-- RViz -->
    <!-- <node if="$(arg rviz)" name="$(anon rviz)" pkg="rviz" type="rviz" 
        respawn="false" 
        args="-d $(find moma_bringup)/rviz/panda_moveit.rviz" 
        output="screen"/> -->

    <!-- Launch grasp node -->
    <node pkg="latobj" type="grasp_object.py" name="grasp_object" 
      args="$(arg out_path) $(arg obj_name)" output="screen"/>

    <!-- Lauch rosbag record -->
    <!-- <node pkg="rosbag" type="record" name="rosbag_record_ft"
       args="record -O $(arg out_path)/$(arg obj_name) /ft_sensor_topic /joint_states /tf /tf_static"/>   -->


</launch>
