<launch>
    <!-- object base -->
    <!-- The z component is equal with the table surface -->
    <!-- config if NO bota is mounted -->
    <!-- bota is 3.5cm long -->
    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="object_base" args="0.5 0.0 0.284 1 0 0 0 panda_link0 object_base" /> -->
    <!-- config if bota is mounted -->
    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="object_base" args="0.5 0.0 0.319 1 0 0 0 panda_link0 object_base" /> -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="object_base" args="0.5 0.0 0.324 1 0 0 0 panda_link0 object_base" />

    <!-- middle point -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="middle" args="0.5 0 0.6 1 0 0 0 panda_link0 middle" />

    <!-- tower base -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="tower_base" args="0.5 -0.1 0.30 1 0 0 0 panda_link0 tower_base" />
</launch>
